<UserControl x:Class="Pasteory.Windows.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pasteory.Windows">
    <Grid Background="{DynamicResource Workspace}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="232"/><ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="DetailsColumn" Width="336"/>
        </Grid.ColumnDefinitions>
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Background="{DynamicResource SubNav}">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="10,8">
                    <TextBlock x:Name="CollectionCount" HorizontalAlignment="Right" Foreground="{DynamicResource Quiet}" FontSize="11"/>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="Navigation" Margin="10,8,10,10"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                    Background="{DynamicResource Nav}" Padding="18,14,18,14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,3">
                        <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="NewText" Style="{StaticResource IconButton}" Content="&#xE710;" Click="CreateText"
                                    ToolTip="{local:Label 'New text clip'}" AutomationProperties.Name="{local:Label 'New text clip'}" Margin="0,0,5,0"/>
                            <Button x:Name="Tools" Click="ShowTools" Foreground="{DynamicResource AccentInk}" Padding="8,3" MinHeight="24"
                                    FontSize="11" AutomationProperties.Name="{local:Label 'Quick actions'}" Margin="0,0,5,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentInk}" Margin="0,1,4,0"/>
                                    <TextBlock Text="{local:Label 'Quick actions'}" VerticalAlignment="Center"/>
                                    <TextBlock Text="⌄" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Border CornerRadius="11" Padding="7,5" Background="{DynamicResource SoftSurface}" VerticalAlignment="Center">
                                <TextBlock x:Name="Count" FontSize="10.5" Foreground="{DynamicResource Muted}"/>
                            </Border>
                        </WrapPanel>
                        <TextBlock x:Name="Heading" FontSize="23" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="Subtitle" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>
                    <Expander x:Name="ThemeOverview" Header="{local:Label 'AI group overview'}" Visibility="Collapsed" Margin="0,0,0,10">
                        <StackPanel x:Name="ThemeOverviewBody" Margin="14,4,4,4"/>
                    </Expander>
                    <Border CornerRadius="11" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                            BorderThickness="1" Padding="10,2,4,2" MouseLeftButtonDown="FocusSearch">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="SearchHint" Grid.Column="1" Text="{local:Label 'Search content, notes, groups or sources'}"
                                       FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBox x:Name="Search" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0"
                                     VerticalAlignment="Center" TextChanged="SearchChanged"
                                     AutomationProperties.Name="{local:Label 'Search clips'}"/>
                            <Button x:Name="ClearSearch" Grid.Column="2" Style="{StaticResource IconButton}" Visibility="Collapsed"
                                    Content="&#xE711;" Click="ClearQuery" AutomationProperties.Name="{local:Label 'Clear search'}"/>
                        </Grid>
                    </Border>
                    <Border x:Name="SelectionBar" Visibility="Collapsed" Background="{DynamicResource AccentTint}"
                            CornerRadius="8" Padding="7,4,5,4" Margin="0,7,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="{local:Label 'Cancel'}" Click="CancelMarking" MinHeight="23" Padding="5,2" Margin="4,0"/>
                                <Button x:Name="AggregateSelectionButton" Content="{local:Label 'Aggregate selection'}"
                                        Click="AggregateResults" Style="{StaticResource PrimaryButton}" MinHeight="23" Padding="7,2"/>
                            </StackPanel>
                            <TextBlock x:Name="MarkStatus" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </DockPanel>
                    </Border>
                    <WrapPanel x:Name="ResultActions" HorizontalAlignment="Right" Margin="0,7,0,0" Visibility="Collapsed">
                        <Button x:Name="AggregateButton" Content="{local:Label 'Aggregate results'}" Click="AggregateResults" Visibility="Collapsed" Margin="0,0,6,0"/>
                        <Button x:Name="DetailsButton" Content="{local:Label 'View details'}" Click="ShowDetails" Visibility="Collapsed" Margin="0,0,6,0"/>
                        <Button x:Name="EmptyTrashButton" Content="{local:Label 'Empty Trash'}" Click="EmptyTrash" Visibility="Collapsed"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Grid>
                <ListBox x:Name="ClipList" Style="{StaticResource ClipList}" ItemTemplate="{StaticResource ClipCard}"
                         ItemContainerStyle="{StaticResource LibraryClipRow}" Padding="13,15,13,12"
                         SelectionChanged="SelectedChanged" MouseDoubleClick="UseSelected" PreviewMouseLeftButtonDown="SelectMultipleRows"
                         PreviewMouseRightButtonDown="SelectContextRow" AutomationProperties.Name="{local:Label 'Library results'}"/>
                <TextBlock x:Name="EmptyMessage" VerticalAlignment="Center" HorizontalAlignment="Center"
                           MaxWidth="280" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Muted}"/>
            </Grid>
        </DockPanel>
        <Border x:Name="DetailsPane" Grid.Column="2" Background="{DynamicResource Detail}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
            <ContentControl x:Name="DetailsHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Border>
    </Grid>
</UserControl>
