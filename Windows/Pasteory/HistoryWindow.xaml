<Window x:Class="Pasteory.Windows.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pasteory.Windows"
        Title="Pasteory" Width="380" Height="660" MinWidth="340" MinHeight="395"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False">
    <Border x:Name="Shell" Background="{DynamicResource Panel}" CornerRadius="16"
            BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <Grid x:Name="FocusArea" Focusable="True" FocusVisualStyle="{x:Null}" KeyboardNavigation.TabNavigation="Cycle">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="8,10,7,8" MouseLeftButtonDown="DragHeader">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ProfileOptions" Content="&#xE8FD;" Style="{StaticResource IconButton}" Click="ShowProfileOptions"
                            ToolTip="{local:Label 'Group view'}" AutomationProperties.Name="{local:Label 'Group view'}" Visibility="Collapsed"/>
                    <Button x:Name="PanelPin" Content="&#xE840;" Style="{StaticResource IconButton}" Click="TogglePinPanel"
                            ToolTip="{local:Label 'Keep panel open'}" AutomationProperties.Name="{local:Label 'Keep panel open'}" Margin="0,0,5,0"/>
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="16" Background="{DynamicResource Surface}" Height="30"
                        Padding="9,0,4,0" MouseLeftButtonDown="SearchClick">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Muted}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="SearchHint" Grid.Column="1" Text="{local:Label 'Type to search…'}"
                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="Query" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0"
                                 VerticalContentAlignment="Center" VerticalAlignment="Stretch" TextChanged="QueryChanged"
                                 AutomationProperties.Name="{local:Label 'Search clips'}"/>
                        <Button x:Name="ClearSearch" Grid.Column="2" Content="&#xE711;" Click="ClearQuery"
                                Style="{StaticResource IconButton}" Visibility="Collapsed" ToolTip="{local:Label 'Clear search'}"
                                AutomationProperties.Name="{local:Label 'Clear search'}"/>
                    </Grid>
                </Border>
                <Button x:Name="QuickTools" Grid.Column="2" Content="&#xE90F; &#xE70D;" Style="{StaticResource IconButton}" Click="ShowTools"
                        Foreground="{DynamicResource AccentInk}" Margin="5,0,3,0"
                        ToolTip="{local:Label 'Quick actions'}" AutomationProperties.Name="{local:Label 'Quick actions'}"/>
                <Button x:Name="UpdateButton" Grid.Column="3" Content="{local:Label 'Update ↓'}" Click="ShowUpdate"
                        MinHeight="26" Padding="7,3" Margin="2,0,5,0" Background="#FCDEA0" Foreground="#462B03"
                        FontSize="11" FontWeight="SemiBold" Visibility="Collapsed"/>
                <Button Grid.Column="4" Content="&#xE713;" Style="{StaticResource IconButton}" Click="OpenSettings"
                        ToolTip="{local:Label Settings}" AutomationProperties.Name="{local:Label Settings}"/>
            </Grid>
            <Grid x:Name="GroupStrip" Grid.Row="1" Margin="9,4,7,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ListBox x:Name="Groups" Style="{StaticResource TabList}" SelectionChanged="GroupChanged"
                         PreviewMouseRightButtonDown="GroupContextMenu"
                         PreviewMouseWheel="ScrollGroups" PreviewMouseLeftButtonDown="GroupDragStart"
                         PreviewMouseMove="GroupDragMove" DragOver="GroupDragOver" Drop="GroupDropped" AllowDrop="True"
                         AutomationProperties.Name="{local:Label Groups}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding HintText}">
                                <TextBlock FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Text" Value="{Binding Glyph}"/>
                                            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAi}" Value="True">
                                                    <Setter Property="Text" Value="AI"/>
                                                    <Setter Property="FontFamily" Value="Segoe UI"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Name}" FontSize="12" MaxWidth="68" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button x:Name="AllGroups" Grid.Column="1" Style="{StaticResource IconButton}" Click="ShowGroups"
                        ToolTip="{local:Label 'All groups'}" AutomationProperties.Name="{local:Label 'All groups'}"/>
            </Grid>
            <Border x:Name="ScopeBar" Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="9,4,10,7">
                <DockPanel>
                    <TextBlock x:Name="GroupPosition" DockPanel.Dock="Right" FontSize="10.5" Foreground="{DynamicResource Quiet}" Margin="8,0,0,0"/>
                    <TextBlock x:Name="CurrentGroup" FontSize="10.5" Foreground="{DynamicResource Quiet}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
            <DockPanel Grid.Row="3">
              <Border x:Name="ResultBar" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource AccentTint}"
                      BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="9,4,10,4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="CancelMulti" Content="{local:Label 'Cancel'}" Click="CancelMarking" Visibility="Collapsed"
                                Padding="5,2" MinHeight="21" FontSize="10.5" Margin="2,0,4,0"/>
                        <Button x:Name="AggregateButton" Content="{local:Label 'Aggregate results'}" Click="AggregateResults"
                                Style="{StaticResource PrimaryButton}" Padding="7,2" MinHeight="21" FontSize="10.5"/>
                    </StackPanel>
                    <TextBlock x:Name="ResultStatus" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               AutomationProperties.LiveSetting="Polite"/>
                </DockPanel>
              </Border>
              <Grid x:Name="ResultColumns">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <DockPanel x:Name="Sidebar" Visibility="Collapsed" Width="144" Margin="4,1,4,0">
                    <Button DockPanel.Dock="Top" Content="{local:Label 'All groups'}" Click="ShowGroups"
                            ToolTip="{local:Label 'All groups'}" Margin="3,5,3,3"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SidebarGroups" Margin="3,4,3,8"/>
                    </ScrollViewer>
                </DockPanel>
                <ListBox x:Name="History" Grid.Column="1" Style="{StaticResource ClipList}" ItemTemplate="{StaticResource ClipCard}"
                         ItemContainerStyle="{StaticResource ClipRow}" Padding="9,7,9,0" MouseDoubleClick="UseSelected"
                         PreviewMouseLeftButtonDown="SelectMultipleRows"
                         PreviewMouseRightButtonDown="SelectContextRow" ContextMenuOpening="ShowContextMenu"
                         SelectionChanged="SelectionChanged" AutomationProperties.Name="{local:Label 'Clipboard history'}"/>
                <TextBlock x:Name="EmptyMessage" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="16,10" IsHitTestVisible="False"/>
              </Grid>
            </DockPanel>
            <Border Grid.Row="4" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="6,4,12,4">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE8FD;" Click="OpenLibrary"
                            FontSize="11" MinHeight="18" Padding="3,1,6,1" MinWidth="18"
                            ToolTip="{local:Label 'Open library'}" AutomationProperties.Name="{local:Label 'Open library'}"/>
                    <TextBlock x:Name="NavigationHint" DockPanel.Dock="Right" Text="{local:Label '↑↓ Clips  ←→ Groups  Hold Ctrl'}"
                               VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource Muted}" Margin="7,0,0,0"/>
                    <Button x:Name="UndoAggregationButton" DockPanel.Dock="Right" Content="{local:Label 'Undo'}"
                            Click="UndoAggregation" Visibility="Collapsed" MinHeight="19" Padding="5,1" FontSize="10.5"
                            Margin="6,0,0,0"/>
                    <TextBlock x:Name="Status" FontSize="10.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                </DockPanel>
            </Border>
            <Thumb Grid.Row="4" Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Cursor="SizeNWSE" DragDelta="ResizePanel" DragCompleted="SavePanelSize"
                   ToolTip="{local:Label 'Resize panel'}">
                <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template>
            </Thumb>
            <Grid x:Name="Overlay" Grid.RowSpan="5" Visibility="Collapsed" Background="#60141724">
                <ContentControl x:Name="OverlayContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Margin="10" Focusable="False"/>
            </Grid>
        </Grid>
    </Border>
</Window>
