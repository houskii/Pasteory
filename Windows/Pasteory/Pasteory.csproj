<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets/Pasteory.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF creates HWNDs before the optional WinForms tray menu is initialized. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <Version>0.1.57</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Pasteory.Core/Pasteory.Core.csproj" />
    <Resource Include="Assets/Pasteory.ico" />
    <Content Include="../../ChromeExtension/**/*" Link="ChromeExtension/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" GeneratePathProperty="true" />
    <PackageReference Include="LzfseSharp" Version="2.0.0" GeneratePathProperty="true" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" GeneratePathProperty="true" />
    <EmbeddedResource Include="../../Config/UpdatePublicKey.txt" LogicalName="Pasteory.UpdatePublicKey.txt" />
    <None Include="$(PkgMicrosoft_Web_WebView2)/LICENSE.txt" Condition="Exists('$(PkgMicrosoft_Web_WebView2)/LICENSE.txt')"
          Link="ThirdPartyNotices/WebView2-LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(PkgMicrosoft_Web_WebView2)/NOTICE.txt" Condition="Exists('$(PkgMicrosoft_Web_WebView2)/NOTICE.txt')"
          Link="ThirdPartyNotices/WebView2-NOTICE.txt" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(PkgLzfseSharp)/LICENSE" Condition="Exists('$(PkgLzfseSharp)/LICENSE')"
          Link="ThirdPartyNotices/LzfseSharp-LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(PkgBouncyCastle_Cryptography)/LICENSE.md" Condition="Exists('$(PkgBouncyCastle_Cryptography)/LICENSE.md')"
          Link="ThirdPartyNotices/BouncyCastle-LICENSE.md" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="Pasteory.Windows.Tests" />
  </ItemGroup>
</Project>
