<UserControl x:Class="Pasteory.Windows.LinkHistoryList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pasteory.Windows">
    <Grid>
        <ListBox x:Name="Records" Style="{DynamicResource ClipList}" Padding="0,0,5,0"
                 AutomationProperties.Name="{local:Label 'Link records'}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter HorizontalAlignment="Stretch"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHeading}" Value="True">
                            <Setter Property="Focusable" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.Resources>
                <DataTemplate DataType="{x:Type local:LinkHistoryHeading}">
                    <DockPanel Margin="3,6,3,7">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{DynamicResource Muted}" FontSize="11"/>
                        <TextBlock Text="{Binding Date}" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="SemiBold"/>
                    </DockPanel>
                </DataTemplate>
                <DataTemplate DataType="{x:Type local:LinkHistoryCard}">
                    <Border Style="{DynamicResource SectionCard}" Padding="13,10" Margin="0,0,0,7">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Border DockPanel.Dock="Right" Background="{DynamicResource SoftSurface}" CornerRadius="9"
                                        Padding="7,3" Margin="8,0,0,0" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Status}" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningInk}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Entry.Status}" Value="Resolved">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessInk}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Entry.Status}" Value="Not attempted">
                                                        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Entry.CannotAccess}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding Entry.Title}" TextTrimming="CharacterEllipsis" FontSize="14"
                                           FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{Binding Entry.Title}"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Entry.Address}" TextTrimming="CharacterEllipsis" FontFamily="Consolas"
                                       Foreground="{DynamicResource Muted}" FontSize="11" ToolTip="{Binding Entry.Address}"/>
                            <TextBlock Text="{Binding Sources}" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,4,0,1"
                                       Foreground="{DynamicResource Muted}" ToolTip="{Binding Sources}"/>
                            <TextBlock Text="{Binding Times}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
                            <TextBlock Text="{local:Label 'Latest request failed. Showing the previous title.'}" Margin="0,4,0,0"
                                       FontSize="11" Foreground="{DynamicResource WarningInk}" TextWrapping="Wrap"
                                       Visibility="{Binding RetainsPreviousTitle, Converter={StaticResource ShowWhen}}"/>
                            <DockPanel Margin="0,6,0,0">
                                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <Button Content="{Binding RetryLabel}" IsEnabled="{Binding CanRetry}" Click="OnRetry" Padding="8,3" MinHeight="24"/>
                                    <Button Content="{Binding SignInLabel}" Click="OnSignIn" Margin="5,0,0,0" Padding="8,3" MinHeight="24"
                                            IsEnabled="{Binding CanRetry}" Visibility="{Binding HasIssue, Converter={StaticResource ShowWhen}}"/>
                                    <Button Content="{local:Label More}" Click="OnMore" Margin="5,0,0,0" Padding="8,3" MinHeight="24"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding Diagnostics}" Foreground="{DynamicResource Muted}" FontSize="11"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,5,0"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.Resources>
        </ListBox>
        <TextBlock x:Name="Empty" Text="{local:Label 'No links match the current filters.'}" Visibility="Collapsed"
                   FontSize="13" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="10,10"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
