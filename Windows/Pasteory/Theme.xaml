<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Pasteory.Windows">
    <SolidColorBrush x:Key="Canvas" Color="#F6F7FB"/>
    <SolidColorBrush x:Key="Workspace" Color="#F6F7FB"/>
    <SolidColorBrush x:Key="Detail" Color="#F4F5FC"/>
    <SolidColorBrush x:Key="Nav" Color="#FDFDFE"/>
    <SolidColorBrush x:Key="SubNav" Color="#E8E8EA"/>
    <SolidColorBrush x:Key="Panel" Color="#E0E0E2"/>
    <SolidColorBrush x:Key="Surface" Color="#FEFEFF"/>
    <SolidColorBrush x:Key="SoftSurface" Color="#F1F1F4"/>
    <SolidColorBrush x:Key="Ink" Color="#242426"/>
    <SolidColorBrush x:Key="Muted" Color="#656568"/>
    <SolidColorBrush x:Key="Quiet" Color="#818186"/>
    <SolidColorBrush x:Key="Line" Color="#E6E6ED"/>
    <SolidColorBrush x:Key="Accent" Color="#4A61F5"/>
    <SolidColorBrush x:Key="AccentInk" Color="#384DDD"/>
    <SolidColorBrush x:Key="AccentTint" Color="#E8EBFD"/>
    <SolidColorBrush x:Key="PanelTint" Color="#C8CDF1"/>
    <SolidColorBrush x:Key="CodeBackground" Color="#F0EAFB"/>
    <SolidColorBrush x:Key="CodeInk" Color="#7438DC"/>
    <SolidColorBrush x:Key="LinkInk" Color="#0769DB"/>
    <SolidColorBrush x:Key="Danger" Color="#BE3441"/>
    <SolidColorBrush x:Key="WarningInk" Color="#9A5409"/>
    <SolidColorBrush x:Key="SuccessInk" Color="#217057"/>
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="NavSelectionInk" Color="White"/>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#4A61F5" Offset="0"/>
        <GradientStop Color="#8C40E8" Offset="1"/>
    </LinearGradientBrush>

    <BooleanToVisibilityConverter x:Key="ShowWhen"/>
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="{DynamicResource Canvas}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="MinHeight" Value="29"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="FieldBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Background="Transparent"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True"
                               Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}"
                               Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource Quiet}" Opacity=".35" CornerRadius="3" Margin="2,0,1,0"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="9"/>
                            <Setter Property="Width" Value="Auto"/>
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,3"/>
    </Style>
    <Style x:Key="SettingsSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" Background="{DynamicResource SoftSurface}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1">
                        <Ellipse x:Name="Handle" Width="14" Height="14" HorizontalAlignment="Left" Margin="2,0"
                                 Fill="White" Stroke="{DynamicResource Line}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Handle" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentInk}"/>
                            <Setter TargetName="Track" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SoftSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Padding" Value="11,5"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="7" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value=".80"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value=".64"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value=".40"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="ContentTemplate">
            <Setter.Value><DataTemplate><TextBlock Text="{Binding}" Foreground="White"/></DataTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="MinWidth" Value="24"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Margin" Value="0,2"/>
    </Style>
    <Style x:Key="MenuSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="7,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="5"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ContextMenu">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border x:Name="Surface" Style="{StaticResource MenuSurface}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Highlight" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuShortcut"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuArrow"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Shortcut" Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                                           Foreground="{DynamicResource Muted}" Margin="18,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Arrow" Grid.Column="2" Text="›" Foreground="{DynamicResource Muted}"
                                           Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Right" AllowsTransparency="True" Focusable="False"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Style="{StaticResource MenuSurface}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="InputGestureText" Value="">
                            <Setter TargetName="Shortcut" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Highlight" Property="Background" Value="{DynamicResource AccentTint}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Highlight" Property="Opacity" Value=".52"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource Line}" Margin="6,3"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GroupSidebarDivider" TargetType="Thumb">
        <Setter Property="Width" Value="7"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SectionCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="13"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="ClipList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    </Style>
    <Style x:Key="ClipRow" TargetType="ListBoxItem">
        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Margin" Value="0,0,0,7"/>
        <Setter Property="MinHeight" Value="{Binding CompactHeight}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="TreeLine" Width="2" Margin="2,0,9,-7" Background="{DynamicResource Accent}" Visibility="Collapsed"/>
                        <Border x:Name="Card" Grid.Column="1" CornerRadius="14"
                                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsChild}" Value="True"><Setter TargetName="TreeLine" Property="Visibility" Value="Visible"/></DataTrigger>
                        <DataTrigger Binding="{Binding Clip.Pinned}" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentTint}"/></DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentInk}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentInk}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentTint}"/>
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="LibraryClipRow" TargetType="ListBoxItem" BasedOn="{StaticResource ClipRow}">
        <Setter Property="MinHeight" Value="{Binding LibraryHeight}"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="SettingsPicker" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Background" Value="{DynamicResource SoftSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="Padding" Value="9,4,8,4"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Item" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="5">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Item" Property="Background" Value="{DynamicResource AccentTint}"/>
                                    </Trigger>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Item" Property="Background" Value="{DynamicResource SoftSurface}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="PickerToggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1" CornerRadius="7">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <DockPanel Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                                <Path DockPanel.Dock="Right" Data="M1,1 L4.5,4.5 L8,1" Stroke="{DynamicResource Muted}"
                                      StrokeThickness="1.2" VerticalAlignment="Center" Margin="9,1,0,0"/>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="3" IsOpen="{TemplateBinding IsDropDownOpen}"
                               Focusable="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border MinWidth="{TemplateBinding ActualWidth}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                    Background="{DynamicResource Surface}" Padding="3" CornerRadius="7">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="PickerToggle" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PickerToggle" Property="Opacity" Value=".52"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SettingsSegmentedTabs" TargetType="TabControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" HorizontalAlignment="Left" Padding="3"
                                CornerRadius="9" Background="{DynamicResource SoftSurface}">
                            <UniformGrid Rows="1" IsItemsHost="True" KeyboardNavigation.TabNavigation="Once"/>
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="12,5"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Segment" Margin="1,0" Padding="{TemplateBinding Padding}" CornerRadius="7"
                                        BorderBrush="Transparent" BorderThickness="1" Background="Transparent">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Segment" Property="Background" Value="{DynamicResource Surface}"/>
                                        <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource Line}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TabList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        <Setter Property="ItemsPanel">
            <Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Pill" CornerRadius="7" Padding="7,4" Margin="0,0,4,0" Background="Transparent">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource SoftSurface}"/></Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource PanelTint}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="GroupPickerRow">
        <DockPanel Margin="5,3" ToolTip="{Binding HintText}">
            <TextBlock DockPanel.Dock="Right" Text="⋮⋮" Foreground="{DynamicResource Quiet}" VerticalAlignment="Center"
                       Visibility="{Binding CanReorder, Converter={StaticResource ShowWhen}}" Margin="7,0,0,0"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Hint}" FontSize="10" VerticalAlignment="Center"
                       Foreground="{DynamicResource Muted}" Margin="7,0,0,0"/>
            <TextBlock DockPanel.Dock="Left" Width="24" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource AccentInk}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Text" Value="{Binding Glyph}"/>
                        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAi}" Value="True">
                                <Setter Property="Text" Value="AI"/>
                                <Setter Property="FontFamily" Value="Segoe UI"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="AggregationMemberRow">
        <Border Background="{DynamicResource SoftSurface}" CornerRadius="7" Padding="6,3" Margin="0,0,2,4">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="−" Style="{StaticResource IconButton}" Padding="3,0" MinHeight="20" MinWidth="22"
                        ToolTip="{local:Label 'Remove from aggregation'}" AutomationProperties.Name="{local:Label 'Remove from aggregation'}"
                        IsEnabled="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" FontFamily="{StaticResource IconFont}"
                           Foreground="{DynamicResource AccentInk}" VerticalAlignment="Center" Margin="0,0,7,0" />
                <TextBlock Text="{Binding Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="ClipCard">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMissingFile}" Value="True"><Setter Property="Opacity" Value="0.53"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid Width="{Binding SourceWidth}" VerticalAlignment="Center" ToolTip="{Binding Source}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Width="{Binding SourceIconSize}" Height="{Binding SourceIconSize}" CornerRadius="9" Background="{DynamicResource AccentTint}">
                    <Grid>
                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding AppIcon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Border>
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,-1" Width="18" Height="18"
                        CornerRadius="9" Background="{DynamicResource Accent}" BorderThickness="1.3" BorderBrush="{DynamicResource Surface}">
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="8" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Source}" FontSize="9" Foreground="{DynamicResource Muted}"
                           TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,1,0,0"/>
            </Grid>
            <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Visibility="{Binding HasTitle, Converter={StaticResource ShowWhen}}"
                           Foreground="{DynamicResource AccentInk}" FontWeight="SemiBold" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                <local:FilePreviewPanel Visibility="{Binding IsFile, Converter={StaticResource ShowWhen}}"/>
                <StackPanel Visibility="{Binding HasImage, Converter={StaticResource ShowWhen}}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Left" Width="{Binding ContentImageWidth}" Height="46" Margin="0,0,7,0">
                            <Border Background="{DynamicResource SoftSurface}" CornerRadius="8"
                                    Visibility="{Binding NeedsImageFallback, Converter={StaticResource ShowWhen}}">
                                <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                           Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <TextBlock Text="{Binding ImageDetails}" Foreground="{DynamicResource Muted}" FontSize="10.5"
                                   LineHeight="13.5" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding ImageText}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="42"/>
                </StackPanel>
                <Grid Visibility="{Binding IsPlainPreview, Converter={StaticResource ShowWhen}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="{Binding ColorSwatch}" Visibility="{Binding IsColor, Converter={StaticResource ShowWhen}}"
                            Width="42" Height="42" CornerRadius="8" Margin="0,1,8,1"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"/>
                    <Border Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" CornerRadius="4">
                        <TextBlock Text="{Binding Body}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="47"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCode}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CodeBackground}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource CodeInk}"/>
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Setter Property="Padding" Value="4,0"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLink}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource LinkInk}"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Setter Property="FontSize" Value="12.5"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsColor}" Value="True">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="FontSize" Value="12"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
                <TextBlock Text="{Binding Note}" Visibility="{Binding HasNote, Converter={StaticResource ShowWhen}}" FontSize="10.5"
                           Foreground="{DynamicResource Quiet}" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="{Binding Metadata}" FontSize="10" Foreground="{DynamicResource Muted}"/>
                    <TextBlock Text="&#xE840;" Visibility="{Binding Clip.Pinned, Converter={StaticResource ShowWhen}}" FontFamily="{StaticResource IconFont}"
                               FontSize="9.5" Foreground="{DynamicResource AccentInk}" Margin="6,1,0,0"/>
                    <TextBlock Text="★" Visibility="{Binding Clip.Favorite, Converter={StaticResource ShowWhen}}" Foreground="#C59506" Margin="5,-2,0,0"/>
                    <TextBlock Text="&#xE70F;" Visibility="{Binding IsEditedChild, Converter={StaticResource ShowWhen}}"
                               FontFamily="{StaticResource IconFont}" FontSize="9.5" Foreground="{DynamicResource Muted}" Margin="5,1,0,0"/>
                    <TextBlock Text="&#xE8B7;" Visibility="{Binding HasGroups, Converter={StaticResource ShowWhen}}"
                               FontFamily="{StaticResource IconFont}" FontSize="9.5" Foreground="{DynamicResource Muted}" Margin="5,1,0,0"/>
                </StackPanel>
            </StackPanel>
            <DockPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Chevron}" Foreground="{DynamicResource AccentInk}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <Border Width="16" Height="16" Margin="5,0,0,0" CornerRadius="8" BorderThickness="1"
                        Visibility="{Binding ShowsMark, Converter={StaticResource ShowWhen}}" IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource Quiet}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                    <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsMarked, Converter={StaticResource ShowWhen}}"/>
                </Border>
            </DockPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
