{
  "manifest_version": 3,
  "name": "Pasteory Web Context",
  "version": "0.1.0",
  "description": "把复制内容与网页链接、标题和附近元素关联后保存到 Pasteory。",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Pasteory 网页来源采集",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
