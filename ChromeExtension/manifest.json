{
  "manifest_version": 3,
  "name": "Pasteory Web Context",
  "version": "0.1.0",
  "description": "Save copied content to Pasteory with its page URL, title, and nearby context.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Pasteory Web Context",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
